			if (pc.getInventory().checkItem(714, 1)) { // 체크 되는 아이템과 수량


				if (pc.isWarrior()) {
					stageReward(tx, messages, 50021, 20, 0, 129, 0, true); // 봉인 해제 주문서
					stageReward(tx, messages, 400254, 1, 0, 129, 0, true); // 아데나 수표(1억)
