package l1j.server.server.model.item.function;
import l1j.server.server.model.network.core.sc.packet.SC_SPMR;

import l1j.server.server.model.network.core.sc.packet.SC_MpUpdate;
import l1j.server.server.model.network.core.sc.packet.SC_SkillSound;
import l1j.server.server.model.Instance.L1ItemInstance;
import l1j.server.server.model.Instance.L1PcInstance;
import l1j.server.server.model.character.skill.L1SkillId;
import l1j.server.server.model.character.skill.L1SkillUse;
import l1j.server.server.model.network.core.sc.packet.SC_OwnCharStatus;
import l1j.server.server.model.network.core.sc.packet.SC_PacketBox;


/**
 * 빙수 / 통합버프 아이템 처리.
 * 별도 Controller 없음.
 * 별도 1초 카운트 없음.
 * 기존 L1SkillTimer -> L1SkillStop 종료처리 사용.
 */

/** Shared ice buff application and skill-effect cleanup. */
final class IceBuffEffects {
    private IceBuffEffects() {}

	static void applyStrIce(
			L1PcInstance pc,
			int timeMillis) {

		pc.addHitup(5);
		pc.addDmgup(3);
		pc.getAbility().addAddedStr(1);

		pc.setSkillEffect(
				L1SkillId.완력빙수,
				timeMillis);

		SC_OwnCharStatus.send(pc);

		final long ss = SC_SkillSound.pack(
						pc.getId(),
						7954);

		SC_SkillSound.sendPacked(pc, ss);
		SC_SkillSound.broadcastPacked(pc, ss);
	}



	static void applyDexIce(
			L1PcInstance pc,
			int timeMillis) {

		pc.addBowHitup(5);
		pc.addBowDmgup(3);
		pc.getAbility().addAddedDex((byte) 1);

		pc.setSkillEffect(
				L1SkillId.민첩빙수,
				timeMillis);

		SC_OwnCharStatus.send(pc);

		SC_PacketBox.send(pc, SC_PacketBox.ER_UpDate, pc.getTotalER());

		final long ss = SC_SkillSound.pack(
						pc.getId(),
						7952);

		SC_SkillSound.sendPacked(pc, ss);
		SC_SkillSound.broadcastPacked(pc, ss);
	}



	static void applyIntIce(
			L1PcInstance pc,
			int timeMillis) {

		pc.addMaxMp(50);
		pc.getAbility().addSp(2);
		pc.getAbility().addAddedInt(1);

		pc.setSkillEffect(
				L1SkillId.지식빙수,
				timeMillis);

		SC_SPMR.send(pc);

		SC_OwnCharStatus.send(pc);

		SC_MpUpdate.send(pc, pc.getCurrentMp(), pc.getMaxMp());

		final long ss = SC_SkillSound.pack(
						pc.getId(),
						7956);

		SC_SkillSound.sendPacked(pc, ss);
		SC_SkillSound.broadcastPacked(pc, ss);
	}


	static void clearIceBuff(
			L1PcInstance pc) {

		removeEffect(
				pc,
				L1SkillId.완력빙수);

		removeEffect(
				pc,
				L1SkillId.민첩빙수);

		removeEffect(
				pc,
				L1SkillId.지식빙수);
	}



	static void clearCashScrollBuff(
			L1PcInstance pc) {

		removeEffect(
				pc,
				L1SkillId.STATUS_CASHSCROLL);

		removeEffect(
				pc,
				L1SkillId.STATUS_CASHSCROLL2);

		removeEffect(
				pc,
				L1SkillId.STATUS_CASHSCROLL3);

		removeEffect(
				pc,
				L1SkillId.STATUS_CASHSCROLL4);

		removeEffect(
				pc,
				L1SkillId.STATUS_CASHSCROLL5);

		removeEffect(
				pc,
				L1SkillId.STATUS_CASHSCROLL6);
	}



	static void removeEffect(
			L1PcInstance pc,
			int skillId) {

		if (pc.hasSkillEffect(skillId)) {
			pc.removeSkillEffect(skillId);
		}
	}
}
