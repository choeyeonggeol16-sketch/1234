import l1j.server.server.model.character.skill.L1SkillUse;
import l1j.server.server.model.network.core.sc.packet.SC_OwnCharStatus;
import l1j.server.server.model.network.core.sc.packet.SC_PacketBox;


/**
 * 빙수 / 통합버프 아이템 처리.
 * 별도 Controller 없음.
 * 별도 1초 카운트 없음.
 * 기존 L1SkillTimer -> L1SkillStop 종료처리 사용.
 */
public final class IceBuffItem {

	private static final int ITEM_ALL_BUFF = 4100040;
	private static final int ITEM_STR_ICE  = 60208;
	private static final int ITEM_DEX_ICE  = 60209;
	private static final int ITEM_INT_ICE  = 60210;



	private IceBuffItem() {
	}


	/**
	 * @return 해당 클래스에서 처리한 아이템이면 true
	 */
	public static boolean use(L1PcInstance pc, L1ItemInstance item) {
		if (pc == null || item == null) {
			return false;
		}

		switch (item.getItemId()) {
		case ITEM_ALL_BUFF:
			IceBuffAllUse.useAllBuff(pc, item);
			return true;

		case ITEM_STR_ICE:
			IceBuffSingleUse.useStrIce(pc, item);
			return true;

		case ITEM_DEX_ICE:
			IceBuffSingleUse.useDexIce(pc, item);
			return true;

		case ITEM_INT_ICE:
			IceBuffSingleUse.useIntIce(pc, item);
			return true;

		default:
			return false;
		}
	}


	// ========================================================================
	// 단일 빙수
	// ========================================================================





	// ========================================================================
	// 통합 버프
	// ========================================================================



	// ========================================================================
	// 실제 효과 적용
	// ========================================================================





	// ========================================================================
	// 기존 효과 정리
	// ========================================================================



}