package l1j.server.server.model.item.function;

import java.sql.Timestamp;
import l1j.server.server.model.Instance.L1ItemInstance;
import l1j.server.server.model.Instance.L1PcInstance;
import l1j.server.server.model.character.skill.L1SkillId;

/** Shared admission for special maan/raid and voucher items; item effects live in domain handlers. */
public final class SpecialConsumableRouter {
    public enum Result {
        NOT_HANDLED,
        HANDLED,
        RETURN
    }

    static final int ITEM_FAFU_MAAN = 410032;
    static final int ITEM_LIND_MAAN = 410033;
    static final int ITEM_ANTA_MAAN = 410034;
    static final int ITEM_VALA_MAAN = 410035;
    static final int ITEM_BIRTH_MAAN = 410036;
    static final int ITEM_SHAPE_MAAN = 410037;
    static final int ITEM_LIFE_MAAN = 410038;

    static final int ITEM_RAID_1 = 779911;
    static final int ITEM_RAID_2 = 779922;
    static final int ITEM_RAID_3 = 779933;

    static final int ITEM_LIFE_MAAN_ONCE = 3000159;




    private SpecialConsumableRouter() {}

    public static boolean isHandledItem(int itemId) {
        switch (itemId) {
        case ITEM_FAFU_MAAN:
        case ITEM_LIND_MAAN:
        case ITEM_ANTA_MAAN:
        case ITEM_VALA_MAAN:
        case ITEM_BIRTH_MAAN:
        case ITEM_SHAPE_MAAN:
        case ITEM_LIFE_MAAN:
        case ITEM_RAID_1:
        case ITEM_RAID_2:
        case ITEM_RAID_3:
        case ITEM_LIFE_MAAN_ONCE:
        case AdenaVoucherTransactions.ITEM_ADENA_VOUCHER_100M:
        case AdenaVoucherTransactions.ITEM_ADENA_VOUCHER_50M:
        case AdenaVoucherTransactions.ITEM_ADENA_VOUCHER_10M:
            return true;

        default:
            return false;
        }
    }

    public static Result use(
            L1PcInstance pc,
            L1ItemInstance item) {

        if (pc == null || item == null) {
            return Result.NOT_HANDLED;
        }

        final int itemId = item.getItemId();

        if (!isHandledItem(itemId)) {
            return Result.NOT_HANDLED;
        }

        // A voucher is a debit-and-grant transaction, not a normal reusable
        // consumable. Never write its timestamp or start item delay before COMMIT.
        if (itemId == AdenaVoucherTransactions.ITEM_ADENA_VOUCHER_100M
                || itemId == AdenaVoucherTransactions.ITEM_ADENA_VOUCHER_50M
                || itemId == AdenaVoucherTransactions.ITEM_ADENA_VOUCHER_10M) {
            return AdenaVoucherTransactions.useAdenaVoucher(pc, item);
        }

        // Preserve any pre-existing cooldown, but never create or mutate the
        // consumable's last-used timestamp ahead of the durable debit.
        if (itemId == ITEM_LIFE_MAAN_ONCE) {
            final Timestamp previous = item.getLastUsed();
            if (previous != null && System.currentTimeMillis() < previous.getTime())
                return Result.HANDLED;
            return MaanRaidTransactions.useLifeMaanOnce(pc, item);
        }

        Timestamp lastUsed = item.getLastUsed();

        // Raid consumables have a deferred durable debit. Do not modify their
        // live cooldown timestamp until the receipt is committed.
        final boolean raid = itemId == ITEM_RAID_1 || itemId == ITEM_RAID_2
                || itemId == ITEM_RAID_3;
        if (lastUsed == null && !raid) {
            lastUsed = nowTimestamp();
            item.setLastUsed(lastUsed);
        }

        final long now = System.currentTimeMillis();

        if (lastUsed != null && now < lastUsed.getTime()) {
            return Result.HANDLED;
        }

        switch (itemId) {
        case ITEM_FAFU_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.FAFU_MAAN);
            return Result.HANDLED;

        case ITEM_LIND_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.LIND_MAAN);
            return Result.HANDLED;

        case ITEM_ANTA_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.ANTA_MAAN);
            return Result.HANDLED;

        case ITEM_VALA_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.VALA_MAAN);
            return Result.HANDLED;

        case ITEM_BIRTH_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.BIRTH_MAAN);
            return Result.HANDLED;

        case ITEM_SHAPE_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.SHAPE_MAAN);
            return Result.HANDLED;

        case ITEM_LIFE_MAAN:
            MaanRaidTransactions.castAndTouch(pc, item, L1SkillId.LIFE_MAAN);
            return Result.HANDLED;

        case ITEM_RAID_1:
            return MaanRaidTransactions.useRaidItem(
                    pc,
                    item,
                    53,
                    32735,
                    32842,
                    (short) 481,
                    778877,
                    32736,
                    32819,
                    (short) 481);

        case ITEM_RAID_2:
            return MaanRaidTransactions.useRaidItem(
                    pc,
                    item,
                    15403,
                    32544,
                    32863,
                    (short) 12257,
                    778888,
                    32544,
                    32863,
                    (short) 12257);

        case ITEM_RAID_3:
            return MaanRaidTransactions.useRaidItem(
                    pc,
                    item,
                    12862,
                    32744,
                    32808,
                    (short) 41,
                    778899,
                    32736,
                    32799,
                    (short) 41);

        default:
            return Result.NOT_HANDLED;
        }
    }


    static Timestamp nowTimestamp() { return new Timestamp(System.currentTimeMillis()); }
}
